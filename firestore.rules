rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    function isValidEvent(data) {
      return data.keys().hasOnly(['name', 'date', 'time', 'location', 'category', 'notes',
                                  'repetition', 'source', 'sourceEventId', 'createdAt', 'updatedAt'])
        && data.name is string && data.name.size() > 0 && data.name.size() <= 200
        && data.date is string && data.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && (!('time' in data) || (data.time is string && data.time.matches('^([0-9]{2}:[0-9]{2})?$')))
        && (!('location' in data) || (data.location is string && data.location.size() <= 500))
        && (!('notes' in data) || (data.notes is string && data.notes.size() <= 5000))
        && data.category in ['holiday', 'meeting', 'work', 'travel', 'other']
        && data.repetition in ['none', 'weekly', 'monthly', 'yearly']
        && (!('source' in data) || data.source in ['google', 'ics'])
        && (!('sourceEventId' in data) || (data.sourceEventId is string && data.sourceEventId.size() <= 1024));
    }

    // Each user can only read and write their own events.
    match /users/{userId}/events/{eventId} {
      allow read, delete: if isOwner(userId);
      allow create, update: if isOwner(userId) && isValidEvent(request.resource.data);
    }
  }
}
