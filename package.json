{
  "name": "pendly",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:rules": "firebase emulators:exec --only firestore --project demo-pendly \"vitest run --config vitest.rules.config.ts\"",
    "emulators": "firebase emulators:start --project demo-pendly",
    "dev:emulators": "VITE_USE_FIREBASE_EMULATORS=true vite",
    "deploy": "npm run build && firebase deploy --only hosting,firestore:rules"
  },
  "dependencies": {
    "firebase": "^12.19.0",
    "ical.js": "^2.2.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.2",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^4.7.0",
    "firebase-tools": "^14.27.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~5.7.2",
    "vite": "^6.2.0",
    "vitest": "^3.2.7"
  }
}
